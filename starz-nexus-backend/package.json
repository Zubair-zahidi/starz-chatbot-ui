{
  "name": "starz-nexus-backend",
  "version": "4.3.0",
  "description": "Enterprise Cosmic Intelligence Platform Backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:seed": "ts-node src/seeds/index.ts",
    "db:reset": "ts-node src/scripts/resetDatabase.ts",
    "ollama:setup": "ts-node src/scripts/setupOllama.ts",
    "docker:build": "docker build -t starz-nexus-backend .",
    "docker:run": "docker run -p 3001:3001 starz-nexus-backend",
    "docker:compose": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f",
    "docker:stop": "docker-compose down"
  },
  "keywords": [
    "astronomy",
    "ai",
    "chat",
    "cosmic",
    "intelligence",
    "ollama",
    "llama3"
  ],
  "author": "Zubair Zahidi",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "mongoose": "^7.4.0",
    "redis": "^4.6.0",
    "socket.io": "^4.7.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.1",
    "dotenv": "^16.3.1",
    "axios": "^1.5.0",
    "joi": "^17.9.2",
    "winston": "^3.10.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^6.10.0",
    "date-fns": "^2.30.0",
    "crypto": "^1.0.1",
    "node-fetch": "^3.3.1",
    "validator": "^13.9.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "@types/node": "^20.5.9",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/helmet": "^4.0.0",
    "@types/mongoose": "^5.11.97",
    "@types/redis": "^4.0.11",
    "@types/socket.io": "^3.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/morgan": "^1.9.4",
    "@types/validator": "^13.7.17",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    "@typescript-eslint/parser": "^6.6.0",
    "eslint": "^8.48.0",
    "prettier": "^3.0.3",
    "jest": "^29.6.4",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.4",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}